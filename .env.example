# Blog admin (Create React App — prefix with REACT_APP_)
# Required in production builds. In development, defaults are used if unset.
REACT_APP_BLOG_ADMIN_USER=your_username
REACT_APP_BLOG_ADMIN_PASSWORD=your_strong_password

# Optional: hosted pitch PDF URL (defaults to /senary-pitch-deck.pdf in public/)
# REACT_APP_PITCH_DECK_URL=https://example.com/deck.pdf

# Vercel serverless only (not REACT_APP_): POST body forwarded to this URL for investor leads
# INVESTOR_LEAD_WEBHOOK=https://hooks.zapier.com/hooks/catch/...
